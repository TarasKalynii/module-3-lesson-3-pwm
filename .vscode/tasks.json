{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: Прошити USB та показати логи",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/tools/idf.sh", "flash-monitor"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP-IDF: Build",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/tools/idf.sh", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ESP-IDF: Monitor USB serial",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/tools/idf.sh", "monitor"],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    }
  ]
}
